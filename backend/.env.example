# Copy to backend/.env and edit. Never commit .env.
# App role (DML only) used by the running API:
DATABASE_URL=postgresql+psycopg://matchlens_app:CHANGE_ME_APP@127.0.0.1:5432/matchlens
# Owner role used ONLY by Alembic migrations:
MIGRATION_DATABASE_URL=postgresql+psycopg://matchlens_owner:CHANGE_ME_OWNER@127.0.0.1:5432/matchlens

CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DATA_DIR=data
MAX_UPLOAD_MB=5

# Local LLM (Ollama). Run `ollama list` and set a model you actually have.
LLM_ENABLED=true
REQUIRE_LLM=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_S=180
LLM_MAX_REQUIREMENTS=20

# Retrieval: lexical (default, no download) or sentence-transformers (needs: pip install -e ".[ml]")
EMBEDDING_BACKEND=lexical
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional: raises the GitHub API rate limit (public read-only token). Leave empty if unused.
GITHUB_TOKEN=
